default_platform(:android)

AAB = 'app/build/outputs/bundle/release/FastTrack48-release.aab'
MAPPING = 'app/build/outputs/mapping/release/mapping.txt'

platform :android do
  desc "Upload the release bundle and the full listing to the internal track"
  lane :internal do
    upload_to_play_store(
      track: 'internal',
      aab: AAB,
      mapping: MAPPING,
      skip_upload_metadata: false,
      skip_upload_images: false,
      skip_upload_screenshots: false,
      release_status: 'draft'
    )
  end

  desc "Promote whatever is on the internal track to production"
  lane :promote do
    upload_to_play_store(
      track: 'internal',
      track_promote_to: 'production',
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      release_status: 'completed'
    )
  end

  # Release notes belong to a release, so supply refuses to upload changelogs
  # without a version_code telling it which release to attach them to. This lane
  # ships no binary and creates no release, so changelogs are skipped here; they
  # go up with the bundle in :internal and :deploy. Pass version_code=<code> to
  # rewrite the notes of a release that is already live on the given track.
  desc "Upload the listing text and graphics only, with no new binary"
  lane :metadata do |options|
    code = options[:version_code]
    upload_to_play_store(
      track: options[:track] || 'production',
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: false,
      skip_upload_images: false,
      skip_upload_screenshots: false,
      skip_upload_changelogs: code.nil?,
      **(code.nil? ? {} : { version_code: code.to_i })
    )
  end

  desc "Deploy straight to Play Store production"
  lane :deploy do
    upload_to_play_store(
      track: 'production',
      aab: AAB,
      mapping: MAPPING,
      skip_upload_metadata: false,
      skip_upload_images: false,
      skip_upload_screenshots: false,
      release_status: 'completed'
    )
  end
end
