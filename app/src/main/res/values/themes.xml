<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
	<!--
		Window chrome only: every screen draws itself in Compose (ui/theme/Theme.kt). AppCompat
		because the activities are AppCompatActivity, which requires a Theme.AppCompat descendant.
		The window colours match the Compose background, so nothing flashes before the first frame.
	-->
	<style name="Theme.FastTrackTheme" parent="Base.Theme.FastTrackTheme" />

	<style name="Base.Theme.FastTrackTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
		<!-- Recents and task colours. -->
		<item name="colorPrimary">@color/purple_500</item>
		<item name="colorPrimaryDark">@color/purple_700</item>
		<item name="colorAccent">@color/purple_200</item>
		<item name="android:colorBackground">@color/white_50</item>
		<item name="android:windowBackground">?android:attr/colorBackground</item>
		<item name="android:statusBarColor">?android:attr/colorBackground</item>
		<item name="android:windowLightStatusBar">true</item>
		<item name="android:navigationBarColor">?android:attr/colorBackground</item>
		<item name="android:windowLightNavigationBar" tools:ignore="NewApi">true</item>
		<item name="android:navigationBarDividerColor" tools:ignore="NewApi">?attr/colorControlHighlight</item>
	</style>
</resources>
