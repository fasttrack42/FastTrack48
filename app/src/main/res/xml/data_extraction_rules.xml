<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
	<cloud-backup>
		<include domain="sharedpref" path="."/>
		<include domain="database" path="."/>
		<!-- Device-bound: the location the user shared for sunrise times never leaves the phone. -->
		<exclude domain="sharedpref" path="lunar_device.xml"/>
	</cloud-backup>
	<device-transfer>
		<include domain="sharedpref" path="."/>
		<include domain="database" path="."/>
		<exclude domain="sharedpref" path="lunar_device.xml"/>
	</device-transfer>
</data-extraction-rules>
