<?xml version="1.0" encoding="utf-8"?>
<!--
	The languages this app actually ships translations for.

	Android's per-app language picker (system Settings, API 33+) reads this list, and so does
	the in-app picker — indirectly, via SupportedLanguageTags, which must stay in step with it.
	Offering anything beyond these tags would only promise a translation that does not exist.

	Tags are region-qualified wherever the res/values-* folder is, so the requested locale
	matches a resource folder exactly instead of relying on language-level fallback.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android"
	android:defaultLocale="en">
	<locale android:name="de"/>
	<locale android:name="en"/>
	<locale android:name="es"/>
	<locale android:name="fr"/>
	<locale android:name="it"/>
	<locale android:name="nl"/>
	<locale android:name="pt-BR"/>
	<locale android:name="uk-UA"/>
	<locale android:name="zh-CN"/>
</locale-config>
